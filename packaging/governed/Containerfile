# syntax=docker/dockerfile:1
# Governed D09 Pi cell image (rootless Podman/crun), podman-buildable form.
#
# THE SIGNED IMAGE IS NOT BUILT FROM THIS FILE. It is assembled offline and
# reproducibly by packaging/governed/cell_image.py from the same inputs (the
# base images pinned below, the frozen-commit entrypoint, adapter sources and
# mount-target directories); see infra/guest/PROVISIONING-SIGNING.md P3. This
# file documents the same image for a podman-capable host. It will not produce
# the same manifest digest (podman writes its own config and timestamps), so it
# must not be used for the image that gets signed.
#
# Both base images are pinned by index digest (packaging/governed/base-images.lock.json,
# checked by tests/packaging/verify-governed-containerfile-pins.sh). The build
# needs no registry beyond those two digests and runs no package manager.
#
# Build from the repository root:
#   podman build -f packaging/governed/Containerfile -t localhost/tbound/pi-cell:latest .
#
# The image is signed with cosign and its manifest digest is frozen into the
# registered /etc/tbound/d09-cell.json template. It is never pulled at run time
# (podman --pull=never) and is verified offline from a local OCI layout. No
# secret or private signing key belongs in this image.
FROM docker.io/library/golang:1.27.1-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66 AS entrypoint
WORKDIR /src
COPY supervisor/ ./supervisor/
RUN cd supervisor \
 && CGO_ENABLED=0 go build -trimpath -o /out/tbound-pi-entrypoint ./cmd/tbound-cell-entrypoint

FROM docker.io/library/node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
LABEL org.opencontainers.image.title="tbound-pi-cell" \
      org.opencontainers.image.description="Governed D09 Pi worker cell (non-claim-bearing until frozen and signed)" \
      org.opencontainers.image.licenses="MIT"

# The signed, frozen entrypoint measures the TCB, reopens the sealed source
# handles fd4/fd9, applies Landlock, and execs the held fd3 binary.
COPY --from=entrypoint /out/tbound-pi-entrypoint /usr/local/bin/tbound-pi-entrypoint

# Adapter sources only. No `npm install` runs in the build: nothing in the cell
# reads node_modules from this path (the Pi runtime bundle is handed into the
# cell as fd9 and mounted at /runtime), so installing it here only added a
# network dependency and an unpinned input to the signed image.
RUN mkdir -p /usr/local/lib/tbound/runtime
COPY adapter/package.json adapter/package-lock.json /usr/local/lib/tbound/runtime/
COPY adapter/src/ /usr/local/lib/tbound/runtime/src/

# Mount targets must exist in the immutable root. Podman replaces these
# directories with the verified sealed consumer view (/var/lib/tbound/pi-worker),
# runtime bundle (/runtime), and the private in-cell tmpfs (/tmp). HOME/TMPDIR
# are deliberately absent here: the entrypoint creates them on each run's tmpfs
# as the registered non-root UID, so they are never root-owned image directories.
RUN mkdir -p /var/lib/tbound/pi-worker /runtime /work \
 && chmod 755 /var/lib/tbound/pi-worker /runtime /work \
 && command -v /bin/bash >/dev/null

# The launcher supplies the registered non-root UID/GID via rootless
# `--userns=keep-id --user`; the entrypoint verifies that identity and creates
# its own mode-0700 HOME/TMPDIR on the per-run tmpfs.
ENV TBOUND_PREFIX=/var/lib/tbound
RUN mkdir -p /var/lib/tbound && chown -R node:node /var/lib/tbound && chmod 700 /var/lib/tbound

ENTRYPOINT ["/usr/local/bin/tbound-pi-entrypoint"]
