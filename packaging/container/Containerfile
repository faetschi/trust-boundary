# syntax=docker/dockerfile:1
# Container image for the tbound supervisor.
#
# Build from the repository root:
#   podman build -f packaging/container/Containerfile -t tbound:dev .
#   docker build -f packaging/container/Containerfile -t tbound:dev .
#
# This image runs the tbound CLI and bundles a pinned Node + Pi runtime. It is a
# convenient distribution channel, NOT the governed D09 cell: governed
# `serve --pi` still requires a signed host profile and the Podman/crun
# containment profile on the host.
#
# The image also carries `tbound-profile` and, on linux/amd64, an unsigned TCB
# entrypoint binary at /usr/libexec/tbound/tbound-cell-entrypoint. It is
# amd64-only (amd64 Landlock syscall numbers) and is never launched by the
# tbound CLI here; it is a source artifact for the operator's approved offline
# image-signing/profile workflow. Do not treat this convenience image as a
# governed cell or its package-installed binary as admitted trust.

FROM golang:1.27-bookworm AS build
ARG TARGETARCH
RUN test "$TARGETARCH" = "amd64" || { echo "tbound-cell-entrypoint is supported only on linux/amd64" >&2; exit 1; }
WORKDIR /src
COPY supervisor/go.mod supervisor/go.sum ./supervisor/
RUN cd supervisor && go mod download
COPY supervisor/ ./supervisor/
RUN mkdir -p /out \
 && cd supervisor \
 && CGO_ENABLED=0 go build -trimpath -o /out/tbound ./cmd/tbound \
 && CGO_ENABLED=0 go build -trimpath -o /out/tbound-doctor ./cmd/tbound-doctor \
 && CGO_ENABLED=0 go build -trimpath -o /out/tbound-profile ./cmd/tbound-profile \
 && CGO_ENABLED=0 go build -trimpath -o /out/tbound-cell-entrypoint ./cmd/tbound-cell-entrypoint \
 && sha256sum /out/tbound-cell-entrypoint | awk '{print $1}' > /out/entrypoint.sha256 \
 && find cmd/tbound-cell-entrypoint internal/piruntime -type f -name '*.go' ! -name '*_test.go' -print0 | sort -z | xargs -0 sha256sum > /out/entrypoint-sources.sha256 \
 && sha256sum go.mod go.sum >> /out/entrypoint-sources.sha256 \
 && SOURCE_SHA="$(sha256sum /out/entrypoint-sources.sha256 | awk '{print $1}')" \
 && ENTRY_SHA="$(cat /out/entrypoint.sha256)" \
 && TEMPLATE_SHA="$(sha256sum internal/piruntime/d09_template_linux.go | awk '{print $1}')" \
 && GO_VERSION="$(go version)" \
  && printf '{\n  "schema_version":"tbound-cell-entrypoint-metadata/v1",\n  "name":"tbound-cell-entrypoint",\n  "version":"source-build",\n  "os":"linux",\n  "arch":"amd64",\n  "path":"/usr/libexec/tbound/tbound-cell-entrypoint",\n  "sha256":"sha256:%s",\n  "source_commit":"unknown",\n  "source_dirty":null,\n  "source_tree_sha256":"sha256:%s",\n  "entrypoint_source":"supervisor/cmd/tbound-cell-entrypoint/main_linux.go",\n  "entrypoint_source_sha256":"sha256:%s",\n  "d09_template_source":"supervisor/internal/piruntime/d09_template_linux.go",\n  "d09_template_source_sha256":"sha256:%s",\n  "registered_d09_profile_digest":null,\n  "profile_note":"no measured or signed D09 profile is generated by this build",\n  "go_toolchain":"%s",\n  "build_flags":["CGO_ENABLED=0","-trimpath"],\n  "license":"MIT",\n  "license_text_included":false,\n  "signed":false,\n  "signing_note":"unsigned build artifact; signing/profile admission require the approved offline operator workflow"\n}\n' "$ENTRY_SHA" "$SOURCE_SHA" "$(sha256sum cmd/tbound-cell-entrypoint/main_linux.go | awk '{print $1}')" "$TEMPLATE_SHA" "$GO_VERSION" > /out/cell-entrypoint.json

FROM node:24-bookworm-slim
LABEL org.opencontainers.image.title="tbound" \
      org.opencontainers.image.description="Host-side supervisor for the Pi coding agent" \
      org.opencontainers.image.licenses="MIT"

RUN mkdir -p /usr/local/lib/tbound/runtime /usr/libexec/tbound
COPY --from=build /out/tbound /out/tbound-doctor /out/tbound-profile /usr/local/bin/
COPY --from=build /out/tbound-cell-entrypoint /out/cell-entrypoint.json /usr/libexec/tbound/
RUN chmod 0555 /usr/libexec/tbound/tbound-cell-entrypoint \
 && chmod 0444 /usr/libexec/tbound/cell-entrypoint.json
COPY adapter/package.json adapter/package-lock.json /usr/local/lib/tbound/runtime/
COPY adapter/src/ /usr/local/lib/tbound/runtime/src/
RUN cd /usr/local/lib/tbound/runtime \
 && npm install --omit=dev --no-audit --no-fund

# Run as the non-root `node` user shipped by the base image.
ENV TBOUND_PREFIX=/var/lib/tbound
RUN mkdir -p /var/lib/tbound \
 && chown -R node:node /usr/local/lib/tbound /var/lib/tbound \
 && chmod 700 /var/lib/tbound
USER node
VOLUME ["/var/lib/tbound"]

ENTRYPOINT ["tbound"]
CMD ["serve", "--pi", "--native-fixture"]
