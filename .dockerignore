# Narrow the container build context to only what the image needs.
# Docker reads this file; podman and buildah fall back to it when no .containerignore exists.
**
!supervisor
!supervisor/**
!adapter
!adapter/package.json
!adapter/package-lock.json
!adapter/src
!adapter/src/**
adapter/node_modules
supervisor/tbound.exe
supervisor/**/*_test.go
**/*.exe
