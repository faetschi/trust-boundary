# Values for the first freeze of a new chain. Copy to freezes/F100.env (any number above the shared chain's) and keep it uncommitted.
# No BOM, LF only, no quotes or trailing comment on FREEZE, FREEZE_COMMIT or GUEST_IP.
FREEZE=F100
# The 40-hex commit to freeze. It must be HEAD when 10-freeze.sh runs.
FREEZE_COMMIT=FROZEN_COMMIT_TBD
# none starts a new chain: no previous freeze to compare with.
PREV_FREEZE=none
GUEST_IP=192.0.2.1
DR_ADMISSION_ID=route-probe-dr-first
DR_ADMISSION_REFUSE=none
