# Copy to .local/freeze-host.env and adjust. Absolute Linux paths. Gitignored, so it stays on this machine.
# Linux scratch and receipts, until tools/pull-receipts.sh copies them into evidence/.
TBOUND_WORK=/home/YOU/tbound-work
# Home of the freeze chain: the owner keys and every freeze's records. 05-init-chain.sh creates it for a new chain; to continue a chain, restore it from .local/secrets/freeze-home.tar.gz.
OLDH=/home/YOU/tbound-h
GO=/home/YOU/opt/go1.27.1/bin/go
PASSPHRASE_FILE=/home/YOU/.tbound-owner-secret/cosign-passphrase
# A new guest has a new host key. Pin it after verifying it out of band; the defaults are the F14 guest's.
# export TBOUND_GUEST_KNOWN_HOSTS=/path/to/known_hosts
# export TBOUND_GUEST_HOST_ALIAS=guest-name-in-that-file
# Guest identity, same defaults: the ssh key (absolute path) and the admin account the kit logs in as.
# The guest-side tbound-op and guest/05-runtime-swap.sh still name tboundadmin: change the account only with a guest provisioned for it.
# export TBOUND_GUEST_KEY=/path/to/id_ed25519
# export TBOUND_GUEST_ADMIN=tboundadmin
# Windows only. The default is tbound-dev, the distro that infra/workspace/New-TBoundWsl.ps1 creates. Name another one here to override it.
# TBOUND_WSL_DISTRO=tbound-dev
# Linux node for the tests that need it; non-login shells do not load nvm, and WSL interop stays off.
# export PATH=/home/YOU/node-v24.15.0-linux-x64/bin:$PATH
