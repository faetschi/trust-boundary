  stage_hashed "$n" pi-host-profile.ed25519 "$WORK/prof.sig" 256 "${ARGS[2]:-}"
  if [[ $n == dr ]]; then stage_hashed "$n" d09-cell.route-probe.json "$WORK/tpl.json" 65536 "${ARGS[3]:-}"
  else stage_hashed "$n" d09-cell.json "$WORK/tpl.json" 65536 "${ARGS[3]:-}"; fi
