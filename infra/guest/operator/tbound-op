  mkwork
  case $k in
    requests) need_argc 1 1; cp -- "$AUDIT/serve-pi-requests.jsonl" "$WORK/c"; put_out _ "$WORK/c" serve-pi-requests.jsonl; say "collected requests ($(wc -c <"$WORK/c") bytes)";;
