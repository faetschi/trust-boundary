v_cfg_install() {
  local n=${ARGS[0]:-} want; need_argc 2 2; need_name "$n"; need_sha "${ARGS[1]:-}"
  want=$(norm_sha "${ARGS[1]:-}")
  [[ -z $(st_get "$n" client) ]] || die "$n: the one-use admission of this NAME is spent (client-run done)"
  need_inactive; check_tools; mkwork; prep_ga
  stage_hashed "$n" serve-pi-service.json "$WORK/cfg" 16384 "$want"
  cfg_structural "$n" "$WORK/cfg"
  if [[ $n == dr ]]; then
    local a
    a=$CFG_EXTRA
    if [[ $(st_get dr cfg) != "$want" ]]; then
      if grep -qF "\"workflow_admission_id\": \"$a\"" "$CFGTPL"/*.json || { [[ -f $STATE/admissions ]] && grep -qxF -- "$a" "$STATE/admissions"; }; then die "admission id $a was used before"; fi
      printf '%s\n' "$a" >>"$STATE/admissions"
    fi
  fi
  if [[ $n == pilot ]]; then
    [[ -f $GA/state/corpus-digest && $(cat "$GA/state/corpus-digest") == "$CFG_EXTRA" ]] || die "config corpus digest is not the digest of the installed manifest (manifest-install first)"
    panel_args "$ETC/corpus"
    if ((${#PANEL_ARGS[@]})); then
      py "$PY_CFGPOLICY" "$WORK/cfg" "$ETC/corpus/receipt.json" || die "service config does not match the public policy recorded in the installed panel receipt"
    fi
  fi
  if [[ $(sha "$ETC/serve-pi-service.json") == "$want" ]]; then say "config already installed"
  else backup_once "$n" serve-pi-service.json; install_atomic "$WORK/cfg" "$ETC/serve-pi-service.json" 0644; fi
  [[ $(sha "$ETC/serve-pi-service.json") == "$want" ]] || die "installed config differs after install"
  if [[ $(st_get "$n" cfg) == "$want" && $(st_rank "$n") -ge 1 ]]; then say "state $n unchanged: $(st_get "$n" state)"
  else st_reset "$n"; st_put "$n" state config; st_put "$n" cfg "$want"; fi
  say "cfg-install $n ok: $want (state $(st_get "$n" state))"
}

v_reg_measure() {
  local n=${ARGS[0]:-} cs
  need_argc 1 1; need_name "$n"
  need_inactive; check_tools; mkwork; prep_ga
  # The G1 cycle measures before seed-live runs: the live root (and the fence directory in it, which
  # the measurement's baseline scan walks) must exist before managed-root-measure opens it.
  # live_dir keeps an existing inode, so a seeded root is measured, not replaced.
  live_dir
  cs=$(sha "$ETC/serve-pi-service.json")
  [[ $(st_rank "$n") -ge 1 && $(st_get "$n" cfg) == "$cs" ]] || die "$n: installed config is not the one recorded for $n (cfg-install first)"
  [[ ! -e $GA/reg-$n ]] || die "$GA/reg-$n exists already"
  [[ ! -e $CG ]] || die "$CG exists although the service is inactive: owner must inspect it"
  HOOK=cg_cleanup
  mkdir "$CG"; CG_MADE=1
  echo "+cpu +memory +pids" >"$CG/cgroup.subtree_control"
  chown 995:986 "$CG" "$CG/cgroup.procs" "$CG/cgroup.threads" "$CG/cgroup.subtree_control"
  [[ $(cat "$CG/cgroup.type") == domain && $(cat "$CG/cgroup.subtree_control") == "cpu memory pids" && $(wc -c <"$CG/cgroup.procs") == 0 ]] || die "unexpected cgroup state"
  "$TBP" managed-root-measure --root "$LIVE" --service-name tbound-pi --service-group tbound-pi \
    --service-unit /etc/systemd/system/tbound-pi.service --mount-unit /etc/systemd/system/var-lib-tbound-live.mount \
    --runner "$TB" --service-cgroup /system.slice/tbound-pi.service --allowed-client-uids 994 --allowed-client-primary-gid 985 \
    --out "$WORK/managed-live-root.unsigned.json" >/dev/null || die "managed-root-measure failed"
  rmdir "$CG"; CG_MADE=0
  local u=$WORK/managed-live-root.unsigned.json
  [[ $(jget "$u" runner_digest) == "${PIN[TBOUND_DIGEST]}" ]] || die "measured runner_digest != TBOUND_DIGEST"
  [[ $(jget "$u" service_uid) == 995 && $(jget "$u" service_gid) == 986 ]] || die "measured service uid/gid"
  [[ $(jget "$u" service_config_digest) == "$cs" ]] || die "measured service_config_digest != installed config"
  [[ $(jget "$u" passwd_digest) == "$(sha /etc/passwd)" && $(jget "$u" group_digest) == "$(sha /etc/group)" &&
     $(jget "$u" nsswitch_digest) == "$(sha /etc/nsswitch.conf)" ]] || die "measured account digests differ from the files"
  install -d -o root -g root -m 0700 "$GA/reg-$n"
  install -o root -g root -m 0600 "$u" "$GA/reg-$n/managed-live-root.unsigned.json"
  put_out "$n" "$u" managed-live-root.unsigned.json
  say "reg-measure $n ok: $(sha "$u") -> $OUTROOT/$n/managed-live-root.unsigned.json (fetch, sign on the owner machine)"
}

