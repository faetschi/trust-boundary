#!/bin/bash -p
# tbound-op: root-owned operator dispatcher for the TBound guest (spec: DESIGN.md next to this file).
# Installed root:root 0755 at /opt/tbound/operator/tbound-op, called as
#   sudo -n /opt/tbound/operator/tbound-op <verb> [args]
# (sudoers 50-tbound-op: NOPASSWD for exactly this path, env_reset, !setenv).
# No path arguments, no eval, no free-form commands: every verb is a fixed sequence of fixed commands whose inputs are
# (a) NAME/SHA/RUNID/RID arguments checked by anchored regexes, (b) fixed staged file names in ~tboundadmin/stage-<NAME>/
# copied O_NOFOLLOW into a root-only tmpfs work dir and hashed there, (c) pins in /opt/tbound/operator/pins.env.
set -euo pipefail
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export LC_ALL=C
unset BASH_ENV ENV CDPATH GLOBIGNORE || true
IFS=$' \t\n'
cd /

OPDIR=/opt/tbound/operator
PINS=$OPDIR/pins.env
CFGTPL=$OPDIR/cfg-templates
ETC=/etc/tbound
TB=/usr/local/bin/tbound
TBP=/usr/local/bin/tbound-profile
GA=/root/ga
STATE=$GA/state
PREV=$GA/prev
OUTROOT=/var/tmp/tbound-op
LOGF=/var/log/tbound-op.log
LOCK=/run/tbound-op.lock
RUNDIR=/run/tbound-op
ADMIN=tboundadmin
SVC_UNIT=tbound-pi.service
SOCK_UNIT=tbound-pi.socket
CG=/sys/fs/cgroup/system.slice/tbound-pi.service
LIVE_MOUNT=/var/lib/tbound/live
LIVE=$LIVE_MOUNT/root   # the registered live root; the mount root is publication's same-mount staging parent
AUDIT=/var/lib/tbound/audit
CATALOG=/var/lib/tbound/private-admin/workflow-recovery/catalog.jsonl
CLIENT_PRIV=(setpriv --reuid 994 --regid 985 --clear-groups --bounding-set=-all --inh-caps=-all --ambient-caps=-all --no-new-privs --)
SVC_PRIV=(setpriv --reuid 995 --regid 986 --clear-groups --bounding-set=-all --inh-caps=-all --ambient-caps=-all --no-new-privs --)
PODMAN=(env -C / -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/var/lib/tbound/podman-home USER=tbound-pi LOGNAME=tbound-pi
  XDG_RUNTIME_DIR=/run/tbound-pi XDG_CONFIG_HOME=/etc/tbound/podman-config XDG_DATA_HOME=/var/lib/tbound/podman-home/data
  XDG_CACHE_HOME=/run/tbound-pi/cache TMPDIR=/run/tbound-pi/tmp CONTAINERS_CONF=/etc/tbound/podman-config/containers.conf
  CONTAINERS_STORAGE_CONF=/etc/tbound/podman-config/storage.conf LANG=C LC_ALL=C /usr/bin/podman)

re_name='^(smoke|g1|rp|dr|pilot)$'
re_sha='^(sha256:)?[0-9a-f]{64}$'
re_runid='^[A-Za-z0-9._-]{8,128}$'
re_rid='^(smoke|g1|rp|dr)-req-[0-9]{8}T[0-9]{6}Z$'
re_tbr='^tbr-[0-9a-f]{32}$'   # tbound-run request id (client uid 994): abandon only, via runner_rid_abandonable
re_dig='^sha256:[0-9a-f]{64}$'

[[ $EUID -eq 0 ]] || { echo "tbound-op: must run as root (via sudo)" >&2; exit 2; }
WORK=""
HOOK=""
CG_MADE=0
ARGV_Q=$(printf '%q ' "$@")

# ---------------------------------------------------------------------------------------------------------------- log
logline() {
  [[ -e $LOGF ]] || install -m 0640 -o root -g adm /dev/null "$LOGF"
  printf '%s %s %s\n' "$(date -u +%FT%TZ)" "${SUDO_USER:-root}" "$*" >>"$LOGF"
}
cg_cleanup() { if [[ $CG_MADE == 1 ]]; then rmdir "$CG" 2>/dev/null || true; CG_MADE=0; fi; }
on_exit() {
  local rc=$?
  if [[ -n $HOOK ]]; then "$HOOK" || true; fi
  if [[ -n $WORK ]]; then rm -rf -- "$WORK"; fi
  logline "END rc=$rc argv=$ARGV_Q"
  exit "$rc"
}
trap on_exit EXIT
die() { printf 'tbound-op: %s\n' "$*" >&2; logline "FAIL $*"; exit 1; }
usage() { printf 'tbound-op: %s\n' "$*" >&2; logline "USAGE $*"; exit 2; }
say() { printf '%s\n' "$*"; }

logline "BEGIN argv=$ARGV_Q"

# ------------------------------------------------------------------------------------------------- argument grammar
(($# >= 1)) || usage "no verb"
for a in "$@"; do
  [[ $a != *$'\n'* && $a =~ ^[A-Za-z0-9._:,=-]{1,160}$ && $a != *..* ]] || usage "argument outside the allowed alphabet"
done
VERB=$1
shift
ARGS=("$@")
need_argc() { local lo=$1 hi=$2; ((${#ARGS[@]} >= lo && ${#ARGS[@]} <= hi)) || usage "$VERB: wrong number of arguments"; }
need_name() { [[ ${1:-} =~ $re_name ]] || usage "bad NAME"; }
need_sha() { [[ ${1:-} =~ $re_sha ]] || usage "bad SHA"; }
norm_sha() { printf 'sha256:%s' "${1#sha256:}"; }

# ------------------------------------------------------------------------------------------------------------- pins
declare -A PIN
load_pins() {
  local line k v
  [[ -f $PINS && ! -L $PINS && $(stat -c '%u:%a' "$PINS") == 0:444 && $(stat -c '%u:%a' "$OPDIR") == 0:755 ]] || die "pins.env or its directory has the wrong owner/mode"
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ -z $line || $line == \#* ]]; then continue; fi
    if [[ $line =~ ^([A-Z][A-Z0-9_]*)=(sha256:[0-9a-f]{64}|[0-9a-f]{40})$ ]]; then PIN[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
    else die "malformed pins.env line"; fi
  done <"$PINS"
  for k in F TBOUND_DIGEST TBP_DIGEST BUNDLE_DIGEST BASE_TD IMGDIGEST ADMIN_PUB_DIGEST SRC_DIGEST CFG TPL_SMOKE TPL_G1 TPL_RP TPL_PILOT; do
    [[ -n ${PIN[$k]:-} ]] || die "pins.env lacks $k"
  done
}

sha() { local h; h=$(sha256sum -- "$1") || return 1; printf 'sha256:%s' "${h%% *}"; }

anchor_ok() { [[ $(sha "$ETC/pi-host-profile.pub") == "${PIN[ADMIN_PUB_DIGEST]}" ]]; }

# ---------------------------------------------------------------------------------------------- python helpers (-I)
py() { python3 -I -c "$@"; }
read -r -d '' PY_STAGE <<'EOF' || true
import os, stat, sys
home, sub, fn, dest, cap, uid = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], int(sys.argv[5]), int(sys.argv[6])
base = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
def bad(m):
    sys.stderr.write("stage: %s\n" % m)
    sys.exit(1)
try:
    hd = os.open(home, base | os.O_DIRECTORY)
    st = os.fstat(hd)
    if st.st_uid not in (0, uid):
        bad("home directory owner")
    sd = os.open(sub, base | os.O_DIRECTORY, dir_fd=hd)
    st = os.fstat(sd)
    if st.st_uid != uid:
        bad("staging directory owner")
    fd = os.open(fn, base | os.O_NONBLOCK, dir_fd=sd)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        bad("staged file is not a regular file")
    if st.st_uid != uid:
        bad("staged file owner")
    if st.st_size > cap:
        bad("staged file larger than the cap")
    out = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    n = 0
    while True:
        b = os.read(fd, 1 << 20)
        if not b:
            break
        n += len(b)
        if n > cap:
            bad("staged file grew past the cap")
        while b:
            b = b[os.write(out, b):]
    os.fsync(out)
except OSError as e:
    bad(str(e))
EOF
read -r -d '' PY_JGET <<'EOF' || true
import json, sys
d = json.load(open(sys.argv[1], encoding="utf-8"))
k = sys.argv[2]
if not isinstance(d, dict) or k not in d:
    sys.exit(3)
v = d[k]
sys.stdout.write(v if isinstance(v, str) else json.dumps(v, separators=(",", ":")))
EOF
read -r -d '' PY_CFGCHECK <<'EOF' || true
import json, re, sys
tpl = open(sys.argv[1], encoding="utf-8", newline="").read()
got = open(sys.argv[2], encoding="utf-8", newline="").read()
cd, sd, mode = sys.argv[3:6]
def bad(m):
    sys.stderr.write("cfgcheck: %s\n" % m)
    sys.exit(1)
if "\r" in got:
    bad("staged config contains CR")
try:
    json.loads(got)
except ValueError:
    bad("staged config is not JSON")
t = tpl
for key, val in (("containers_conf_digest", cd), ("storage_conf_digest", sd)):
    old = '"%s": "<MEASURE>"' % key
    if t.count(old) != 1:
        bad("template lacks %s" % old)
    t = t.replace(old, '"%s": "%s"' % (key, val))
extra = ""
if mode == "dr":
    tid = re.findall(r'^  "workflow_admission_id": "([^"\\]+)",$', tpl, re.M)
    g = re.findall(r'^  "workflow_admission_id": "([a-z0-9][a-z0-9-]{4,62}[a-z0-9])",$', got, re.M)
    if len(tid) != 1 or len(g) != 1:
        bad("admission id not found exactly once")
    if g[0] == tid[0]:
        bad("dr needs a NEW admission id, not the route-probe one")
    t = t.replace('"workflow_admission_id": "%s"' % tid[0], '"workflow_admission_id": "%s"' % g[0])
    extra = g[0]
elif mode == "pilot":
    g = re.findall(r'"corpus_manifest_digest": "(sha256:[0-9a-f]{64})"', got)
    old = '"corpus_manifest_digest": "<CORPUS_DIGEST>"'
    if len(g) != 1 or t.count(old) != 1:
        bad("corpus digest not found exactly once")
    t = t.replace(old, '"corpus_manifest_digest": "%s"' % g[0])
    extra = g[0]
if t != got:
    tl, gl = t.split("\n"), got.split("\n")
    for i in range(max(len(tl), len(gl))):
        a = tl[i] if i < len(tl) else "<end>"
        b = gl[i] if i < len(gl) else "<end>"
        if a != b:
            bad("differs from the shipped template at line %d: want %r got %r" % (i + 1, a, b))
print(extra)
EOF
read -r -d '' PY_TPLCMP <<'EOF' || true
import json, sys
a = json.load(open(sys.argv[1], encoding="utf-8"))
b = json.load(open(sys.argv[2], encoding="utf-8"))
if "route_probe" not in a or "route_probe" in b:
    sys.exit("probe template must carry route_probe and the production template must not")
del a["route_probe"]
if a != b:
    sys.exit("production template differs from the probe template by more than route_probe")
EOF
read -r -d '' PY_CFGPOLICY <<'EOF' || true
import json, sys
def bad(m):
    sys.stderr.write("policycheck: %s\n" % m)
    sys.exit(1)
try:
    cfg = json.load(open(sys.argv[1], encoding="utf-8"))
    rec = json.load(open(sys.argv[2], encoding="utf-8"))
except (OSError, ValueError) as e:
    bad("cannot read a file: %s" % e)
pol = rec.get("public_policy") if isinstance(rec, dict) else None
if not isinstance(pol, dict):
    bad("the installed panel receipt has no public_policy object")
paths = cfg.get("workflow_bash_output_paths") if isinstance(cfg, dict) else None
if not isinstance(paths, list):
    bad("the service config has no workflow_bash_output_paths list")
if pol.get("bash_output_paths") != paths:
    bad("bash output paths: the receipt policy has %r, the service config %r" % (pol.get("bash_output_paths"), paths))
# Cells run network-none and the service config names no destination, so the raters must have seen none.
if pol.get("network_destinations") != []:
    bad("network destinations: the receipt policy has %r, the service config allows none" % (pol.get("network_destinations"),))
EOF
jget() { py "$PY_JGET" "$1" "$2"; }
jhas() { py "$PY_JGET" "$1" "$2" >/dev/null 2>&1; }

# ------------------------------------------------------------------------------------------------ work dir, outputs
mkwork() {
  [[ -n $WORK ]] && return 0
  install -d -o root -g root -m 0700 "$RUNDIR"
  WORK=$(mktemp -d "$RUNDIR/w.XXXXXX")
}
# Export destination only: nothing under $OUTROOT is ever read back by this script. A directory is accepted only if it is
# root:tboundadmin 0750 (so tboundadmin cannot create or replace entries in it); an existing directory of any other
# owner or mode, or a symlink, makes the verb fail. New directories are created root-owned from the start (mkdir 0700,
# then chown/chmod), never with install -d on a path somebody else may have made.
mk_rootdir() {
  local d=$1
  [[ ! -L $d ]] || die "$d is a symlink: refused"
  if [[ ! -e $d ]]; then
    if mkdir -m 0700 -- "$d" 2>/dev/null; then chown root:"$ADMIN" "$d"; chmod 0750 "$d"; fi
  fi
  [[ -d $d && ! -L $d && $(stat -c '%u:%G:%a' "$d") == "0:$ADMIN:750" ]] || die "$d is not a root:$ADMIN 0750 directory (owner must remove it)"
}
check_outroot() { mk_rootdir "$OUTROOT"; }
outdir() {
  local n=${1:-_}
  mk_rootdir "$OUTROOT"; mk_rootdir "$OUTROOT/$n"
  printf '%s' "$OUTROOT/$n"
}
put_out() {   # NAME srcfile dstname
  local d; d=$(outdir "$1")
  install -o root -g "$ADMIN" -m 0640 "$2" "$d/$3.new"
  mv -f -- "$d/$3.new" "$d/$3"
}
emit() {   # NAME dstname : stdin -> out dir file and stdout
  mkwork
  cat >"$WORK/emit.tmp"
  put_out "$1" "$WORK/emit.tmp" "$2"
  cat "$WORK/emit.tmp"
  rm -f -- "$WORK/emit.tmp"
}
prep_ga() { install -d -o root -g root -m 0700 "$GA" "$STATE" "$PREV"; }

stage_copy() {   # NAME FIXEDFILE DEST CAP
  local home; home=$(getent passwd "$ADMIN" | cut -d: -f6)
  [[ $home == /home/$ADMIN ]] || die "unexpected home of $ADMIN"
  py "$PY_STAGE" "$home" "stage-$1" "$2" "$3" "$4" "$(id -u "$ADMIN")" || die "staged file $1/$2 refused"
}
stage_hashed() {   # NAME FIXEDFILE DEST CAP WANTSHA : copy, hash the COPY, compare
  stage_copy "$1" "$2" "$3" "$4"
  [[ $(sha "$3") == "$(norm_sha "$5")" ]] || die "staged $2 does not hash to the given SHA (copy hashed: $(sha "$3"))"
}

# -------------------------------------------------------------------------------------------------------- state
st_file() { printf '%s/%s' "$STATE" "$1"; }
# one-use markers (client launched, n7 done) live in NAME.once and survive st_reset/rollback
st_kfile() { case $2 in client|n7) printf '%s/%s.once' "$STATE" "$1";; *) st_file "$1";; esac; }
st_get() {   # NAME KEY
  local f; f=$(st_kfile "$1" "$2")
  [[ -f $f ]] || return 0
  sed -n "s/^$2=//p" "$f" | head -1
}
st_put() {   # NAME KEY VALUE
  local f
  f=$(st_kfile "$1" "$2")
  [[ $3 =~ ^[A-Za-z0-9:._,-]*$ ]] || die "state value outside the alphabet"
  { [[ -f $f ]] && grep -v "^$2=" "$f" || true; printf '%s=%s\n' "$2" "$3"; } | sort >"$f.new"
  mv -f -- "$f.new" "$f"
}
st_reset() { rm -f -- "$(st_file "$1")"; }
rank() { case ${1:-} in config) echo 1;; reg) echo 2;; prof) echo 3;; started) echo 4;; *) echo 0;; esac; }
st_rank() { rank "$(st_get "$1" state)"; }
inst_name() {   # NAME of the state whose recorded cfg equals the installed config; empty if none
  local cs n found=""
  cs=$(sha "$ETC/serve-pi-service.json")
  for n in smoke g1 rp dr pilot; do
    if [[ -f $(st_file "$n") && $(st_get "$n" cfg) == "$cs" && $(st_rank "$n") -ge 1 ]]; then
      [[ -z $found ]] || die "two states claim the installed config ($found, $n)"
      found=$n
    fi
  done
  printf '%s' "$found"
}
backup_once() {   # NAME FILE(basename under /etc/tbound)
  install -d -o root -g root -m 0700 "$PREV/$1" "$PREV/$1/$(dirname -- "$2")"
  if [[ -e $PREV/$1/$2 ]]; then return 0; fi
  [[ -e $ETC/$2 ]] || return 0
  cp -p -- "$ETC/$2" "$PREV/$1/$2.new"
  mv -n -- "$PREV/$1/$2.new" "$PREV/$1/$2"
  rm -f -- "$PREV/$1/$2.new"
}
panel_args() {   # DIR -> PANEL_ARGS and PANEL_FILES, optional all-or-none bundle
  local dir=$1 f count=0
  PANEL_ARGS=(); PANEL_FILES=()
  for f in receipt audit stats; do
    if [[ -e $dir/$f.json || -L $dir/$f.json ]]; then
      [[ -f $dir/$f.json && ! -L $dir/$f.json ]] || die "panel file is not regular: $dir/$f.json"
      PANEL_ARGS+=("--panel-$f" "$dir/$f.json"); PANEL_FILES+=("corpus/$f.json")
      count=$((count + 1))
    fi
  done
  [[ $count == 0 || $count == 3 ]] || die "incomplete panel bundle in $dir: all three files or none are required"
}
install_atomic() {   # SRC DST MODE
  if [[ -f $2 && $(sha "$1") == "$(sha "$2")" && $(stat -c '%u:%g:%a' "$2") == "0:0:${3#0}" ]]; then return 0; fi
  install -o root -g root -m "$3" "$1" "$2.new"
  mv -f -- "$2.new" "$2"
}

svc_inactive() {
  local u s
  for u in $SVC_UNIT $SOCK_UNIT; do s=$(systemctl is-active "$u" || true); case $s in inactive|failed) ;; *) return 1;; esac; done
}
svc_active() {
  [[ $(systemctl is-active $SVC_UNIT || true) == active && $(systemctl is-active $SOCK_UNIT || true) == active ]]
}
need_inactive() { svc_inactive || die "tbound-pi.service and .socket must be inactive (svc stop first)"; }

# ------------------------------------------------------------------------------------------------ verification core
podman_cfg_digests() {   # sets CD SD
  CD=$(sha "$ETC/podman-config/containers.conf"); SD=$(sha "$ETC/podman-config/storage.conf")
}
tpl_for() { case $1 in smoke) echo smoke;; g1) echo g1;; rp|dr) echo route-probe;; pilot) echo corpus-pilot;; esac; }
tplpin_for() { case $1 in smoke) echo TPL_SMOKE;; g1) echo TPL_G1;; rp|dr) echo TPL_RP;; pilot) echo TPL_PILOT;; esac; }
cfg_structural() {   # NAME FILE -> CFG_EXTRA
  local n=$1 f=$2 t mode=plain
  t=$CFGTPL/serve-pi-service.$(tpl_for "$n").json
  [[ $(sha "$t") == "${PIN[$(tplpin_for "$n")]}" ]] || die "shipped config template for $n does not match its pin"
  [[ $n == dr ]] && mode=dr
  [[ $n == pilot ]] && mode=pilot
  podman_cfg_digests
  CFG_EXTRA=$(py "$PY_CFGCHECK" "$t" "$f" "$CD" "$SD" "$mode") || die "config for $n is not the shipped template with only the allowed members changed"
}
parse_digest() { sed -n 's/.*digest \(sha256:[0-9a-f]\{64\}\),.*/\1/p' | head -1; }

check_tools() {
  [[ $(sha "$TB") == "${PIN[TBOUND_DIGEST]}" ]] || die "$TB does not match TBOUND_DIGEST"
  [[ $(sha "$TBP") == "${PIN[TBP_DIGEST]}" ]] || die "$TBP does not match TBP_DIGEST"
  anchor_ok || die "/etc/tbound/pi-host-profile.pub does not match ADMIN_PUB_DIGEST"
}
check_registration() {   # REGJSON REGSIG CFGSHA -> REGD
  local out
  out=$("$TBP" managed-root-verify --registration "$1" --sig "$2" --pub "$ETC/pi-host-profile.pub" --runner-digest "${PIN[TBOUND_DIGEST]}" 2>&1) || die "managed-root-verify failed: $out"
  REGD=$(printf '%s\n' "$out" | parse_digest)
  [[ $REGD =~ $re_dig ]] || die "no registration digest in the verify output"
  [[ $out == *"runner ${PIN[TBOUND_DIGEST]}"* ]] || die "registration does not name the pinned runner"
  [[ $(jget "$1" service_config_digest) == "$3" ]] || die "registration does not bind the installed config digest"
  [[ $(jget "$1" runner_digest) == "${PIN[TBOUND_DIGEST]}" ]] || die "registration runner_digest differs from TBOUND_DIGEST"
  [[ $(jget "$1" service_uid) == 995 && $(jget "$1" service_gid) == 986 ]] || die "registration service uid/gid"
  [[ $(jget "$1" passwd_digest) == "$(sha /etc/passwd)" && $(jget "$1" group_digest) == "$(sha /etc/group)" &&
     $(jget "$1" nsswitch_digest) == "$(sha /etc/nsswitch.conf)" ]] || die "account files changed since the registration was measured"
}
check_template_bind() {   # TEMPLATE REGD NAME -> TD (sets TDV, BASEV)
  local out
  out=$("$TBP" template-digest --template "$1" 2>&1) || die "template-digest failed: $out"
  TDV=$(printf '%s\n' "$out" | sed -n 's/^D09 cell template canonical digest: \(sha256:[0-9a-f]\{64\}\)$/\1/p')
  BASEV=$(printf '%s\n' "$out" | sed -n 's/^D09 base template digest .*: \(sha256:[0-9a-f]\{64\}\)$/\1/p')
  [[ $TDV =~ $re_dig && $BASEV =~ $re_dig ]] || die "cannot parse template-digest output"
  [[ $BASEV == "${PIN[BASE_TD]}" ]] || die "template BASE_TD differs from the pin"
  [[ $(jget "$1" managed_live_root_registration_digest) == "$2" ]] || die "template does not name the registration digest"
  [[ $(jget "$1" expected_image_digest) == "${PIN[IMGDIGEST]}" ]] || die "template image is not IMGDIGEST"
  if [[ $3 == dr && $4 == probe ]]; then jhas "$1" route_probe || die "dr probe template lacks route_probe"
  else ! jhas "$1" route_probe || die "template carries route_probe"; fi
}
check_profile() {   # PROFJSON PROFSIG TEMPLATE REGD NAME KIND -> PROFD, TDV
  local out
  out=$("$TBP" verify --profile "$1" --sig "$2" --pub "$ETC/pi-host-profile.pub" --runtime-bundle-digest "${PIN[BUNDLE_DIGEST]}" 2>&1) || die "profile verify failed: $out"
  PROFD=$(printf '%s\n' "$out" | parse_digest)
  [[ $PROFD =~ $re_dig ]] || die "no profile digest in the verify output"
  check_template_bind "$3" "$4" "$5" "${6:-prod}"
  [[ $(jget "$1" ContainmentProfileDigest) == "$TDV" ]] || die "profile ContainmentProfileDigest != template TD"
  [[ $(jget "$1" SourceProvenanceDigest) == "${PIN[SRC_DIGEST]}" ]] || die "profile source digest != SRC_DIGEST"
  [[ $(jget "$1" PiRuntimeBundleDigest) == "${PIN[BUNDLE_DIGEST]}" ]] || die "profile bundle digest != BUNDLE_DIGEST"
}
verify_installed() {   # NAME : the full chain on the installed files
  local n=$1 cfg=$ETC/serve-pi-service.json kind=prod
  check_tools
  VI_CFG=$(sha "$cfg")
  cfg_structural "$n" "$cfg"
  check_registration "$ETC/managed-live-root.json" "$ETC/managed-live-root.ed25519" "$VI_CFG"
  [[ $n == dr ]] && kind=probe
  check_profile "$ETC/pi-host-profile.json" "$ETC/pi-host-profile.ed25519" "$ETC/d09-cell.json" "$REGD" "$n" "$kind"
  VI_REG=$REGD; VI_PROF=$PROFD; VI_TD=$TDV
}
archive_run() {   # NAME [PRODTEMPLATE]
  local n=$1 f d=$GA/$1
  install -d -o root -g root -m 0755 "$d"
  for f in pi-host-profile.json pi-host-profile.ed25519 pi-host-profile.pub managed-live-root.json managed-live-root.ed25519 serve-pi-service.json; do
    install -o root -g root -m 0644 "$ETC/$f" "$d/$f"
  done
  if [[ $n == dr ]]; then
    install -o root -g root -m 0644 "$ETC/d09-cell.json" "$d/d09-cell.route-probe.json"
    if [[ -n ${2:-} ]]; then install -o root -g root -m 0644 "$2" "$d/d09-cell.json"; fi
  else
    install -o root -g root -m 0644 "$ETC/d09-cell.json" "$d/d09-cell.json"
  fi
  mkwork
  (cd "$d" && sha256sum -- * | sort -k2) >"$WORK/archive.sha256"
  put_out "$n" "$WORK/archive.sha256" archive.sha256
  cat "$WORK/archive.sha256"
}
record_chain() {   # NAME STATE : write the installed hashes into the state file
  local n=$1
  st_put "$n" state "$2"
  st_put "$n" cfg "$(sha "$ETC/serve-pi-service.json")"
  st_put "$n" regjson "$(sha "$ETC/managed-live-root.json")"
  st_put "$n" regsig "$(sha "$ETC/managed-live-root.ed25519")"
  st_put "$n" profjson "$(sha "$ETC/pi-host-profile.json")"
  st_put "$n" profsig "$(sha "$ETC/pi-host-profile.ed25519")"
  st_put "$n" tpl "$(sha "$ETC/d09-cell.json")"
  st_put "$n" reg "$VI_REG"; st_put "$n" prof "$VI_PROF"; st_put "$n" td "$VI_TD"
}

