        echo "== service cgroup"; find "$CG" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>&1; stat -c '%U:%G %a' "$CG/cells" 2>&1
        cat "$CG/cells/cgroup.type" "$CG/cells/cgroup.subtree_control" "$CG/cells/cgroup.procs" 2>&1
