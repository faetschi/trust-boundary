    esac
  } >"$WORK/diag.txt" 2>&1 || true
  put_out _ "$WORK/diag.txt" "diag-$k.txt"
  cat "$WORK/diag.txt"
}

v_netsink_rotate() {
  local j=/var/lib/tbound-netsink/journal.jsonl ts; need_argc 0 0
  check_tools; ts=$(date -u +%Y%m%dT%H%M%SZ)
  [[ -f $j && ! -L $j ]] || die "$j is not a regular file"
  systemctl stop tbound-netsink.service
  mv -n -- "$j" "$j.$ts"
  systemctl start tbound-netsink.service
  sleep 1
  [[ $(systemctl is-active tbound-netsink.service || true) == active ]] || die "tbound-netsink.service not active after rotation (journal kept as $j.$ts)"
  say "netsink-rotate ok: $j.$ts ($(stat -c %s "$j.$ts") bytes); new journal $( [[ -f $j ]] && stat -c %s "$j" || echo 'not yet created') bytes"
}

v_status() {
  local n only=${ARGS[0]:-} cs
  ((${#ARGS[@]} <= 1)) || usage "status [NAME]"
  [[ -z $only ]] || need_name "$only"
  say "tbound-op status $(date -u +%FT%TZ) pins F=${PIN[F]}"
  say "anchor: $(anchor_ok && echo ok || echo MISMATCH) (pi-host-profile.pub $(sha "$ETC/pi-host-profile.pub"))"
  say "runner: $(sha "$TB" | cut -c1-23) tbound-profile: $(sha "$TBP" | cut -c1-23)"
  say "service=$(systemctl is-active $SVC_UNIT || true) socket=$(systemctl is-active $SOCK_UNIT || true)"
  cs=$(sha "$ETC/serve-pi-service.json")
  say "installed: cfg $cs reg $(sha "$ETC/managed-live-root.json" | cut -c1-23) prof $(sha "$ETC/pi-host-profile.json" | cut -c1-23) tpl $(sha "$ETC/d09-cell.json" | cut -c1-23)"
  say "installed config matches state of: ${INST:-$(inst_name)}"
  for n in smoke g1 rp dr pilot; do
    [[ -n $only && $only != "$n" ]] && continue
    if [[ -f $STATE/$n.once ]]; then say "-- $n one-use markers: $(tr '\n' ' ' <"$STATE/$n.once")"; fi
    if [[ -f $STATE/$n.client-status ]]; then say "-- $n client-run.status: $(cat "$STATE/$n.client-status")"; fi
    [[ -f $(st_file "$n") ]] || { say "-- $n: no state"; continue; }
    say "-- $n:"; sed 's/^/     /' "$(st_file "$n")"
    [[ -f $GA/out/${RESP_OF[$n]:-x}.err ]] && say "     client stderr: $(head -c 300 "$GA/out/${RESP_OF[$n]}.err")"
  done
  say "-- last log lines"; tail -n 5 "$LOGF" 2>/dev/null || true
}

# ----------------------------------------------------------------------------------------------------- dispatch
load_pins
case $VERB in
  status|diag|collect) ;;
  *)
    exec 9>"$LOCK"
    flock -w 5 9 || die "busy: another tbound-op verb or a client-run holds $LOCK"
    ;;
esac
check_outroot
if [[ $VERB != status ]]; then anchor_ok || die "/etc/tbound/pi-host-profile.pub does not match ADMIN_PUB_DIGEST"; fi
[[ $VERB == status ]] || [[ $VERB == diag || $VERB == collect ]] || prep_ga
case $VERB in
  status) v_status;;
  diag) v_diag;;
  collect) v_collect;;
  cfg-install) v_cfg_install;;
  reg-measure) v_reg_measure;;
  reg-install) v_reg_install;;
  prof-install) v_prof_install;;
  adopt) v_adopt;;
  rollback) v_rollback;;
  manifest-install) v_manifest_install;;
  svc) v_svc;;
  seed-live) v_seed_live;;
  client-run) v_client_run;;
  negative) v_negative;;
  abandon) v_abandon;;
  verify-retained) v_verify_retained;;
  guest-evidence) v_guest_evidence;;
  stage-ga) v_stage_ga;;
  netsink-rotate) v_netsink_rotate;;
  *) usage "unknown verb";;
esac
logline "OK $ARGV_Q"
