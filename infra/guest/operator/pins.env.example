# Template of /opt/tbound/operator/pins.env (root:root 0444 on the guest). Not read by anything in the repo.
# The guest-authoritative file is generated at the frozen commit F from the digest files measured at F
# ($HF1) and parsed (never sourced) by tbound-op: KEY=value, value = sha256:<64 hex> or 40 hex.
# Replace every <measured at F> with the value measured at F; nothing here is valid for another F.
# TPL_SMOKE, TPL_G1, TPL_RP and TPL_PILOT pin the four serve-pi-service.*.json templates, which are the
# files of infra/guest/ (smoke, g1, route-probe, corpus-pilot); the F1 recovery copy of cfg-templates/ was
# byte-identical to them (modulo CR) and is not duplicated under operator/. Install those files as
# /opt/tbound/operator/cfg-templates/.
ADMIN_PUB_DIGEST=<measured at F>
BASE_TD=<measured at F>
BUNDLE_DIGEST=<measured at F>
CFG=<measured at F>
F=<measured at F>
IMGDIGEST=<measured at F>
SRC_DIGEST=<measured at F>
TBOUND_DIGEST=<measured at F>
TBP_DIGEST=<measured at F>
TPL_SMOKE=<measured at F>
TPL_G1=<measured at F>
TPL_RP=<measured at F>
TPL_PILOT=<measured at F>
TEST_ENTRYPOINT=<measured at F>
TEST_PROCORACLE=<measured at F>
